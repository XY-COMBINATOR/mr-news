# ──────────────────────────────────────────────────────────────────────────────
# MR NEWS — Environment Variables Reference
# Copy this file and fill in your actual values in Vercel → Project → Settings → Environment Variables
# NEVER commit real secrets to git. .env.local is in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase Database ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Providers (Multi-tier failover) ───────────────────────────────────────
# Tier 1 — Google Gemini (Primary)
GEMINI_API_KEY=your-gemini-api-key

# Tier 2 — Groq (Auto-fallback if Gemini fails)
GROQ_API_KEY=your-groq-api-key

# Tier 3 — OpenRouter (Auto-fallback if Groq fails)
OPENROUTER_API_KEY=your-openrouter-api-key

# Tier 4 — OpenAI (Optional direct fallback)
OPENAI_API_KEY=your-openai-api-key

# ── Gmail SMTP Email ──────────────────────────────────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password-16-chars
EMAIL_FROM="MR News <your-gmail@gmail.com>"

# ── Security ──────────────────────────────────────────────────────────────────
ADMIN_SECRET=your-admin-passkey-here
CRON_SECRET=your-random-32-char-cron-secret

# ── App & NextAuth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your-random-nextauth-secret-min-32-chars

# ── Google OAuth (optional, configure later) ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
